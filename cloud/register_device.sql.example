-- Replace all placeholders locally. Run in the SQL editor after schema.sql.
-- Generate UUID and token with the README commands. Never commit a filled copy.
insert into safenest_private.devices(id, token_hash)
values ('REPLACE_DEVICE_UUID'::uuid,
        encode(sha256(convert_to('REPLACE_LONG_RANDOM_DEVICE_TOKEN', 'UTF8')), 'hex'));

